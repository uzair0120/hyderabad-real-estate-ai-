<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Hyderabad Estate — VIP Real Estate Platform</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
</head>
<body>
  <!-- AUTH GATE — Must login/register first -->
  <div class="auth-gate" id="authGate">
    <div class="auth-gate-bg"></div>
    <div class="auth-gate-content">
      <div class="auth-gate-logo">
        <span class="auth-gate-icon">🏙️</span>
        <h1>Hyderabad Estate</h1>
        <p class="auth-gate-sub">حیدرآباد اسٹیٹ · VIP Real Estate Platform</p>
      </div>
      <div class="auth-gate-box">
        <!-- Login Form -->
        <div id="gateLoginForm">
          <h2>Welcome Back</h2>
          <p class="auth-gate-desc">Login to access premium properties</p>
          <div class="form-group">
            <label>Email Address</label>
            <input type="email" id="gateLoginEmail" class="form-input" placeholder="your@email.com" />
          </div>
          <div class="form-group">
            <label>Password</label>
            <input type="password" id="gateLoginPassword" class="form-input" placeholder="••••••••" onkeypress="if(event.key==='Enter')doGateLogin()" />
          </div>
          <div id="gateLoginError" class="form-error" style="display:none"></div>
          <button class="btn-primary full-width" onclick="doGateLogin()">Login →</button>
          <p class="auth-switch">Don't have an account? <a href="#" onclick="showGateRegister()">Create Account</a></p>
        </div>
        <!-- Register Form -->
        <div id="gateRegisterForm" style="display:none">
          <h2>Create Account</h2>
          <p class="auth-gate-desc">Join Hyderabad Estate VIP Platform</p>
          <div class="form-group">
            <label>Full Name</label>
            <input type="text" id="gateRegName" class="form-input" placeholder="Muhammad Ali" />
          </div>
          <div class="form-group">
            <label>Email Address</label>
            <input type="email" id="gateRegEmail" class="form-input" placeholder="your@email.com" />
          </div>
          <div class="form-group">
            <label>Phone (Optional)</label>
            <input type="text" id="gateRegPhone" class="form-input" placeholder="03XX-XXXXXXX" />
          </div>
          <div class="form-group">
            <label>Password</label>
            <input type="password" id="gateRegPassword" class="form-input" placeholder="••••••••" onkeypress="if(event.key==='Enter')doGateRegister()" />
          </div>
          <div id="gateRegError" class="form-error" style="display:none"></div>
          <button class="btn-primary full-width" onclick="doGateRegister()">Create Account →</button>
          <p class="auth-switch">Already have an account? <a href="#" onclick="showGateLogin()">Login</a></p>
        </div>
      </div>
    </div>
  </div>

  <!-- MAIN CONTENT (hidden until auth) -->
  <div id="mainContent" style="display:none">
  <!-- 3D ANIMATED BACKGROUND -->
  <div id="bg3d"></div>

  <!-- IMPORTANT NOTICE BANNER -->
  <div class="notice-banner" id="noticeBanner">
    <div class="notice-inner">
      <span class="notice-icon">📢</span>
      <div class="notice-text">
        <strong>IMPORTANT NOTICE — اہم اطلاع</strong>
        &nbsp;|&nbsp;
        Hyderabad Estate is Hyderabad's #1 verified real estate platform — 20 Buildings, 62 Flats, 24 Housing Societies, 38 Brokers.
        &nbsp;|&nbsp;
        <strong>📞 VIP Broker:</strong> Zahid Hussain Al Habib Real Estate
        <div class="notice-btn-row">
          <a href="tel:03013501356" class="notice-btn-call">📞 Call Now</a>
          <a href="https://wa.me/923013501356?text=Hello%2C%20I%20am%20interested%20in%20properties%20in%20Hyderabad" target="_blank" class="notice-btn-wa">💬 WhatsApp</a>
          <span class="notice-num">03013501356</span>
        </div>
        <span class="notice-urdu">پلاٹ یا فلیٹ خریدنے کے لیے ابھی ہمارے بروکر سے رابطہ کریں۔</span>
      </div>
      <button class="notice-close" onclick="document.getElementById('noticeBanner').style.display='none'">✕</button>
    </div>
  </div>

  <!-- NAVBAR -->
  <nav class="navbar" id="navbar">
    <div class="nav-container">
      <div class="nav-logo">
        <span class="logo-icon">🏙️</span>
        <div>
          <div class="logo-text">Hyderabad Estate</div>
          <div class="logo-sub">حیدرآباد اسٹیٹ · VIP Platform</div>
        </div>
      </div>
      <div class="nav-links" id="navLinks">
        <a href="#" onclick="showSection('home')" class="nav-link active">Home</a>
        <a href="#" onclick="showSection('societies')" class="nav-link">🏢 Buildings</a>
        <a href="#" onclick="showSection('flats')" class="nav-link">🏠 Flats</a>
        <a href="#" onclick="showSection('housing')" class="nav-link">🏘️ Housing</a>
        <a href="#" onclick="showSection('brokers')" class="nav-link">👤 Brokers</a>
        <a href="#" onclick="showSection('map')" class="nav-link">🗺️ Map</a>
      </div>
      <div class="nav-auth" id="navAuth">
        <button class="btn-register" onclick="openModal('register')">Register</button>
        <button class="btn-login" onclick="openModal('login')">Login</button>
      </div>
      <div class="nav-user" id="navUser" style="display:none">
        <div class="user-avatar" id="userAvatar">U</div>
        <span id="userName"></span>
        <button class="btn-logout" onclick="logout()">Logout</button>
      </div>
      <button class="hamburger" onclick="toggleMenu()">☰</button>
    </div>
  </nav>

  <!-- HERO SECTION -->
  <section class="hero" id="sectionHome">
    <div class="hero-bg"></div>
    <div class="hero-content">
      <div class="vip-badge">⭐ VIP PLATFORM ⭐</div>
      <h1 class="hero-title">Find Your Dream<br><span class="gold">Apartment in Hyderabad</span></h1>
      <p class="hero-sub">حیدرآباد کے بہترین اپارٹمنٹس — Verified Properties, Trusted Brokers</p>
      <div class="hero-stats">
        <div class="stat"><div class="stat-n" id="statSocieties">20</div><div class="stat-l">Buildings</div></div>
        <div class="stat"><div class="stat-n" id="statBrokers">38</div><div class="stat-l">Brokers</div></div>
        <div class="stat"><div class="stat-n" id="statListings">60+</div><div class="stat-l">Listings</div></div>
        <div class="stat"><div class="stat-n">5⭐</div><div class="stat-l">Rated</div></div>
      </div>
      <div class="hero-search">
        <select id="hsType" class="hs-select">
          <option value="">Rent or Sale?</option>
          <option value="rent">Rent</option>
          <option value="sale">Sale</option>
        </select>
        <select id="hsBeds" class="hs-select">
          <option value="">Bedrooms</option>
          <option value="2">2 Bed</option>
          <option value="3">3 Bed</option>
        </select>
        <button class="btn-search" onclick="doSearch()">🔍 Search Flats</button>
      </div>
    </div>
    <!-- Rating ticker -->
    <div class="rating-ticker">
      <div class="ticker-inner" id="ratingTicker"></div>
    </div>

    <!-- IMPORTANT NOTICE SECTION -->
    <div class="important-notice" id="importantNotice">
      <div class="important-notice-box">
        <div class="important-notice-head">
          <span class="important-notice-icon">📢</span>
          <h3>Important Notice</h3>
        </div>
        <div class="important-notice-body">
          <div class="notice-point">
            <span class="notice-point-icon">🏠</span>
            <div>
              <strong>House Availability:</strong>
              Houses are currently unavailable and marked as <em>"Coming Soon"</em>. They will be available shortly.
            </div>
          </div>
          <div class="notice-point">
            <span class="notice-point-icon">💰</span>
            <div>
              <strong>Dynamic Pricing:</strong>
              Rates for plots and flats (for both rent and sale) are subject to change continuously (daily or monthly). For exact and up-to-date prices, please contact our broker directly.
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4D PROPERTY SHOWCASE (shown only in Flats section) -->
  <section class="showcase-4d" id="showcase4d" style="display:none">
    <div class="showcase-header">
      <h2>🏠 Premium Flats <span class="gold">VIP Collection</span></h2>
      <p>Hover to explore · Click copy for details · 4D parallax effect</p>
    </div>
    <div class="showcase-grid" id="showcaseGrid"></div>
  </section>

  <!-- FEATURED SOCIETIES -->
  <section class="section-wrap" id="sectionFeatured" style="padding-top:40px;">
    <div class="section-header">
      <h2>Featured Properties <span class="badge-gold">VIP PICK</span></h2>
      <p>حیدرآباد کے سب سے بہترین اور معتبر اپارٹمنٹس</p>
    </div>
    <div class="cards-grid" id="featuredGrid"></div>
  </section>

  <!-- ALL SOCIETIES / BUILDINGS -->
  <section class="section-wrap" id="sectionSocieties" style="display:none">
    <div class="section-header">
      <h2>🏢 Buildings & Societies <span class="badge-count" id="societyCount"></span></h2>
      <p>حیدرآباد کی تمام عمارات — Browse all 20 premium buildings</p>
    </div>
    <div class="filter-bar">
      <input type="text" class="filter-input" placeholder="🔍 Search by name or location..." oninput="filterSocieties(this.value)" />
      <select class="filter-select" onchange="filterSocietiesByArea(this.value)">
        <option value="">All Areas</option>
        <option value="Latifabad">Latifabad</option>
        <option value="Qasimabad">Qasimabad</option>
        <option value="Cantt">Cantt / Saddar</option>
      </select>
    </div>
    <div class="cards-grid" id="societiesGrid"></div>
  </section>

  <!-- FLATS / LISTINGS — SEPARATE BLOCK -->
  <section class="section-wrap" id="sectionFlats" style="display:none">
    <div class="section-header">
      <h2>🏠 Available Flats <span class="badge-gold">RENT & SALE</span></h2>
      <p>فلیٹس کی فہرست — All available flats for rent and sale in Hyderabad</p>
    </div>
    <!-- Flat tabs -->
    <div class="flat-tabs">
      <button class="flat-tab active" id="tabAll"    onclick="switchFlatTab('all')">All Flats</button>
      <button class="flat-tab"        id="tabRent"   onclick="switchFlatTab('rent')">🏷️ For Rent</button>
      <button class="flat-tab"        id="tabSale"   onclick="switchFlatTab('sale')">🔑 For Sale</button>
    </div>
    <div class="filter-bar" style="margin-top:0">
      <select class="filter-select" id="flatBedFilter" onchange="applyFlatFilters()">
        <option value="">All Bedrooms</option>
        <option value="2">2 Bed</option>
        <option value="3">3 Bed</option>
      </select>
      <select class="filter-select" id="flatAreaFilter" onchange="applyFlatFilters()">
        <option value="">All Areas</option>
        <option value="Latifabad">Latifabad</option>
        <option value="Qasimabad">Qasimabad</option>
        <option value="Cantt">Cantt / Saddar</option>
      </select>
      <input type="text" class="filter-input" id="flatSearch" placeholder="🔍 Search flat name..." oninput="applyFlatFilters()" />
    </div>
    <div class="flat-count-bar" id="flatCountBar"></div>
    <div class="listings-grid" id="listingsGrid"></div>
  </section>

  <!-- HOUSING SOCIETIES (PLOTS) SECTION -->
  <section class="section-wrap" id="sectionHousing" style="display:none">
    <div class="section-header">
      <h2>🏘️ Housing Societies <span class="badge-count" id="housingCount"></span></h2>
      <p>پلاٹس اور ہاؤسنگ اسکیمز — 24 housing societies with plot rates &amp; details in Hyderabad</p>
    </div>
    <!-- Housing info notice -->
    <div class="housing-notice">
      <span class="housing-notice-icon">🏘️</span>
      <div>
        <strong>Housing Societies — پلاٹس اور اسکیمز</strong> — 24 verified housing societies with plot rates in Hyderabad.
        &nbsp;|&nbsp;
        <strong>Interested in plots?</strong> Contact our VIP broker directly:
        <div class="notice-btn-row" style="margin-top:6px">
          <a href="tel:03013501356" class="notice-btn-call">📞 Call Now</a>
          <a href="https://wa.me/923013501356?text=Hi%2C%20interested%20in%20plots%20in%20Hyderabad" target="_blank" class="notice-btn-wa">💬 WhatsApp</a>
          <span class="notice-num">03013501356</span>
        </div>
      </div>
    </div>
    <div class="filter-bar">
      <input type="text" class="filter-input" id="housingSearch" placeholder="🔍 Search society name or area..." oninput="filterHousing(this.value)" />
      <select class="filter-select" onchange="filterHousingByArea(this.value)">
        <option value="">All Areas</option>
        <option value="Bypass">Hyderabad Bypass</option>
        <option value="Qasimabad">Qasimabad</option>
        <option value="Latifabad">Latifabad</option>
        <option value="Badin">Badin Road</option>
      </select>
    </div>
    <div class="housing-count-bar" id="housingCountBar"></div>
    <div class="housing-grid" id="housingGrid"></div>
  </section>

  <!-- BROKERS SECTION -->
  <section class="section-wrap" id="sectionBrokers" style="display:none">
    <div class="section-header">
      <h2>Our Verified Brokers <span class="badge-gold">38 Active</span></h2>
      <p>ہمارے قابل اعتماد اور ماہر بروکر — رنگ کالم سے ٹائر معلوم کریں</p>
    </div>
    <!-- Color legend -->
    <div class="color-legend">
      <div class="legend-item"><span class="dot" style="background:#4f8ef7"></span> VIP 5-Star — Zahid Hussain Al Habib</div>
      <div class="legend-item"><span class="dot" style="background:#38d9c0"></span> Premium 4-Star Brokers</div>
      <div class="legend-item"><span class="dot" style="background:#9b72f5"></span> Standard 3.5-Star Brokers</div>
    </div>
    <div class="brokers-grid" id="brokersGrid"></div>
  </section>

  <!-- MAP SECTION -->
  <section class="section-wrap" id="sectionMap" style="display:none">
    <div class="section-header">
      <h2>🗺️ Property Locations <span class="badge-gold">Hyderabad</span></h2>
      <p>All buildings, flats &amp; housing societies on interactive map — click any dot for details</p>
    </div>
    <div class="map-legend">
      <span class="legend-item"><span class="legend-dot" style="background:#FFD700"></span> Buildings</span>
      <span class="legend-item"><span class="legend-dot" style="background:#4f8ef7"></span> Flats</span>
      <span class="legend-item"><span class="legend-dot" style="background:#38d9c0"></span> Housing Societies</span>
      <span class="legend-item"><span class="legend-dot" style="background:#ff6b6b"></span> VIP Broker Zone</span>
    </div>
    <div id="map" style="height:650px;border-radius:18px;overflow:hidden;border:2px solid var(--gold);box-shadow:0 0 40px rgba(79,142,247,0.15);"></div>
  </section>

  <!-- SOCIETY DETAIL MODAL -->
  <div class="modal-overlay" id="societyModal" onclick="closeSocietyModal(event)">
    <div class="modal-box modal-large">
      <button class="modal-close" onclick="closeSocietyModal()">✕</button>
      <div id="societyModalContent"></div>
    </div>
  </div>

  <!-- AUTH MODAL -->
  <div class="modal-overlay" id="authModal" onclick="closeAuthModal(event)">
    <div class="modal-box">
      <button class="modal-close" onclick="closeAuthModal()">✕</button>
      <!-- Login Form -->
      <div id="loginForm">
        <div class="auth-header">
          <div class="auth-icon">🔐</div>
          <h2>Login</h2>
          <p>Welcome back to Hyderabad Estate VIP</p>
        </div>
        <div class="form-group">
          <label>Email Address</label>
          <input type="email" id="loginEmail" class="form-input" placeholder="your@email.com" />
        </div>
        <div class="form-group">
          <label>Password</label>
          <input type="password" id="loginPassword" class="form-input" placeholder="••••••••" />
        </div>
        <div id="loginError" class="form-error" style="display:none"></div>
        <button class="btn-primary full-width" onclick="doLogin()">Login →</button>
        <p class="auth-switch">Don't have an account? <a href="#" onclick="openModal('register')">Register</a></p>
      </div>
      <!-- Register Form -->
      <div id="registerForm" style="display:none">
        <div class="auth-header">
          <div class="auth-icon">✨</div>
          <h2>Create Account</h2>
          <p>Join Hyderabad Estate VIP Platform</p>
        </div>
        <div class="form-group">
          <label>Full Name</label>
          <input type="text" id="regName" class="form-input" placeholder="Muhammad Ali" />
        </div>
        <div class="form-group">
          <label>Email Address</label>
          <input type="email" id="regEmail" class="form-input" placeholder="your@email.com" />
        </div>
        <div class="form-group">
          <label>Phone (Optional)</label>
          <input type="text" id="regPhone" class="form-input" placeholder="03XX-XXXXXXX" />
        </div>
        <div class="form-group">
          <label>Password</label>
          <input type="password" id="regPassword" class="form-input" placeholder="••••••••" />
        </div>
        <div id="regError" class="form-error" style="display:none"></div>
        <button class="btn-primary full-width" onclick="doRegister()">Create Account →</button>
        <p class="auth-switch">Already registered? <a href="#" onclick="openModal('login')">Login</a></p>
      </div>
    </div>
  </div>

  <!-- AI CHATBOT -->
  <div class="chat-widget" id="chatWidget">
    <div class="chat-header" onclick="toggleChat()">
      <div class="chat-avatar">🤖</div>
      <div>
        <div class="chat-title">Hyderabad Estate AI</div>
        <div class="chat-sub">Ask me about any property!</div>
      </div>
      <div class="chat-status online"></div>
      <button class="chat-voice-toggle" id="chatVoiceToggle" onclick="event.stopPropagation(); toggleAgentVoice()" title="Toggle AI Voice">🔊</button>
    </div>
    <div class="chat-body" id="chatBody">
      <div class="chat-msgs" id="chatMsgs">
        <div class="msg bot">
          <div class="msg-bubble">
            Assalam u Alaikum! 🌟 Welcome to <strong>Hyderabad Estate VIP Platform</strong>!<br><br>
            Main aapka AI Real Estate Agent hoon. Hyderabad ke best apartments ke baare mein kuch bhi poochein!<br><br>
            <em>Try: "Show me luxury apartments" ya "Qasimabad mein 2-bed flat chahiye"</em>
          </div>
        </div>
      </div>
      <div class="chat-input-row">
        <button class="chat-mic" id="chatMic" onclick="toggleVoice()" title="Speak your question">🎤</button>
        <input type="text" id="chatInput" class="chat-input" placeholder="Type or speak your question..." onkeypress="chatKeypress(event)" />
        <button class="chat-send" onclick="sendChat()">➤</button>
      </div>
    </div>
  </div>
  <button class="chat-fab" id="chatFab" onclick="toggleChat()">
    <span>💬</span>
    <span class="fab-label">AI Agent</span>
  </button>

  <!-- Toast Notification -->
  <div class="toast" id="toast"></div>

  <footer class="footer">
    <div class="footer-content">
      <div class="footer-brand">
        <div class="logo-text" style="font-size:1.4rem">🏙️ Hyderabad Estate</div>
        <p>حیدرآباد کا سب سے معتبر ریئل اسٹیٹ پلیٹ فارم</p>
        <p>Zahid Hussain Al Habib Real Estate</p>
        <div class="footer-btn-row">
          <a href="tel:03013501356" class="footer-btn-call">📞 Call</a>
          <a href="https://wa.me/923013501356?text=Hello%2C%20I%20am%20interested%20in%20properties%20in%20Hyderabad" target="_blank" class="footer-btn-wa">💬 WhatsApp</a>
          <span class="footer-num">03013501356</span>
        </div>
      </div>
      <div class="footer-links">
        <h4>Quick Links</h4>
        <a href="#" onclick="showSection('societies')">🏢 Buildings</a>
        <a href="#" onclick="showSection('flats')">🏠 Flats</a>
        <a href="#" onclick="showSection('housing')">🏘️ Housing</a>
        <a href="#" onclick="showSection('brokers')">👤 Brokers</a>
        <a href="#" onclick="showSection('map')">🗺️ Map</a>
      </div>
      <div class="footer-contact">
        <h4>⭐ VIP Broker</h4>
        <p>Zahid Hussain — Al Habib Real Estate</p>
        <p>5-Star Verified ⭐⭐⭐⭐⭐</p>
        <div class="footer-btn-row" style="margin-top:10px">
          <a href="tel:03013501356" class="footer-btn-call">📞 Call</a>
          <a href="https://wa.me/923013501356?text=Hello%2C%20interested%20in%20Hyderabad%20properties" target="_blank" class="footer-btn-wa">💬 WhatsApp</a>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <p>© 2026 Hyderabad Estate VIP Platform — All Rights Reserved</p>
      <p class="footer-powered">Powered by Uzair Zahid</p>
    </div>
  </footer>

  </div><!-- /mainContent -->

  <!-- AMBIENT MUSIC — hidden audio element + top-right speaker button -->
  <audio id="ambientAudio" loop preload="auto" crossorigin="anonymous">
    <source src="https://archive.org/download/100_free_royalty_background_music_tracks/AutoMeditate.mp3" type="audio/mpeg">
    <source src="https://archive.org/download/100_free_royalty_background_music_tracks/dreams.mp3" type="audio/mpeg">
  </audio>
  <button class="ambient-top-btn" id="ambientTopBtn" onclick="toggleAmbientMusic()" title="Toggle Background Music" style="display:none">
    <span class="ambient-top-icon" id="ambientTopIcon">🔇</span>
    <span class="ambient-top-label" id="ambientTopLabel">Music OFF</span>
    <div class="ambient-top-wave" id="ambientTopWave">
      <span></span><span></span><span></span><span></span>
    </div>
  </button>

  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script src="/js/app.js"></script>
</body>
</html>
